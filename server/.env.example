# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dynamic_qr_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Base URLs (Used for dynamic QR target links and CORS)
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Default Admin Seed Credentials (used only on first startup if no admin exists)
ADMIN_INITIAL_EMAIL=ritikvarun64@gamil.com
ADMIN_INITIAL_PASSWORD=Ritik@1234
